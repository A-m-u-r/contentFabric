# Runtime settings only. The deployment helper writes IMAGE_PREFIX and
# IMAGE_TAG to a separate images.env so rollback never replaces saved keys.

# N100: process one video generation job at a time.
MAX_CONCURRENT_JOBS=1

# Setup generates a private value. Keep it across updates: it encrypts saved keys.
OPENSHORTS_KEY_VAULT_SECRET=

# Optional platform credentials. A free account can instead save its own keys
# in the dashboard. Never send filled values to GitHub or in a project archive.
GEMINI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
UPLOAD_POST_API_KEY=

# S3 backup/gallery is optional.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BUCKET=
