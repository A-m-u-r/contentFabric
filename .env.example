# Local development. For the home server use deploy/SETUP.txt.
MAX_CONCURRENT_JOBS=1

# Production setup generates this secret; preserve it across updates.
OPENSHORTS_KEY_VAULT_SECRET=

# Optional server credentials; personal keys can be saved in app Settings.
GEMINI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
UPLOAD_POST_API_KEY=

# Optional S3 storage. Leave empty without your own buckets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BUCKET=

# Optional YouTube cookies in Netscape format.
# YOUTUBE_COOKIES=
