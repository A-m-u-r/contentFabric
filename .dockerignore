# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
ENV/
.eggs/
*.egg-info/
.pytest_cache/

# Node
node_modules/
remotion/node_modules/
render-service/node_modules/
dashboard/node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Video files (will be mounted via volume)
*.mp4
*.avi
*.mov
*.mkv
*.gif
videos/

# Model files (downloaded at build time)
*.pt

# HuggingFace / model caches — symlink farm that breaks BuildKit context
# transfer ("invalid file request"), and is re-downloaded at runtime anyway.
.cache/
**/.cache/

# Runtime scratch/state — recreated on start and bind-mounted at runtime
# (backend mounts .:/app + ./output), so it never needs to be baked in.
output/
uploads/
.claude/
.env
.env.*
!.env.example
.pptx-build/
tmp/
voice_test/
screenshots/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Docs
README.md
*.md
!THIRD_PARTY_NOTICES.md







